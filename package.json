{
  "name": "package-lens",
  "displayName": "Package Lens",
  "description": "为 pnpm-workspace.yaml 和 package.json 提供 npm 包版本提示、自动补全和版本状态显示",
  "version": "0.2.0",
  "publisher": "sj817",
  "icon": "images/icon.png",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other",
    "Linters"
  ],
  "keywords": [
    "pnpm",
    "workspace",
    "npm",
    "version",
    "catalog",
    "package.json",
    "依赖管理"
  ],
  "activationEvents": [
    "onLanguage:yaml",
    "onLanguage:json",
    "workspaceContains:pnpm-workspace.yaml",
    "workspaceContains:package.json"
  ],
  "main": "./dist/extension.cjs",
  "contributes": {
    "commands": [
      {
        "command": "packageLens.selectVersion",
        "title": "选择版本",
        "category": "Package Lens"
      },
      {
        "command": "packageLens.refreshCache",
        "title": "刷新版本缓存",
        "category": "Package Lens"
      }
    ],
    "configuration": {
      "title": "Package Lens",
      "properties": {
        "packageLens.registry": {
          "type": "string",
          "default": "",
          "description": "自定义 npm 镜像源地址。留空则自动竞速选择最快的源(npm 官方 / npmmirror)"
        },
        "packageLens.cacheTimeout": {
          "type": "number",
          "default": 300000,
          "description": "缓存超时时间（毫秒），默认 5 分钟"
        },
        "packageLens.showVersionStatus": {
          "type": "boolean",
          "default": true,
          "description": "是否在行尾显示版本状态 Emoji"
        },
        "packageLens.showLatestVersionHint": {
          "type": "boolean",
          "default": true,
          "description": "悬停时是否显示最新版本提示"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "pnpm run compile -- --minify",
    "compile": "tsdown",
    "watch": "tsdown --watch",
    "pretest": "pnpm run compile && pnpm run lint",
    "lint": "oxlint src",
    "test": "vscode-test",
    "package": "vsce package --no-dependencies",
    "publish": "vsce publish --no-dependencies"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^3.2.2",
    "json5": "^2.2.3",
    "oxlint": "^1.51.0",
    "tsdown": "^0.21.1",
    "typescript": "^5.9.3",
    "yaml": "^2.3.4"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/sj817/package-lens"
  },
  "bugs": {
    "url": "https://github.com/sj817/package-lens/issues"
  },
  "homepage": "https://github.com/sj817/package-lens#readme",
  "license": "MIT"
}